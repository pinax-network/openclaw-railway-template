{
  "name": "openclaw-railway-template",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run src/server.ts",
    "start": "bun run src/server.ts",
    "lint": "bun run --bun src/server.ts --dry-run || true",
    "test": "bun test",
    "smoke": "bun run scripts/smoke.js",
    "smoke:gateway": "node scripts/smoke-local-gateway.mjs"
  },
  "devDependencies": {
    "@types/bun": "1.4.3"
  },
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": ">=1.4.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "onFail": "error"
    }
  }
}
